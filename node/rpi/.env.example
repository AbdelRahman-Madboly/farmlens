# FarmLens node configuration
# Copy to .env and edit. Lines starting with # are ignored.
# After editing on the Pi: sudo systemctl restart farmlens

# Node identity
NODE_ID=FL-001
NODE_NAME=FarmLens Node

# Network. 0.0.0.0 lets phones on the LAN connect; use 127.0.0.1 for a
# local-only demo. There is no TLS: keep the node on a trusted network.
API_HOST=0.0.0.0
API_PORT=8000

# Optional shared key. When set, POST /api/sensor and POST /api/settings
# require the header "X-API-Key: <value>". Leave empty to disable.
API_KEY=

# Sensor source: "mock" (simulated readings) or "esp32" (firmware posts them)
SENSOR_MODE=mock
SENSOR_INTERVAL_S=5

# Camera: "mock" (synthetic frames), "picamera2" (CSI camera), "opencv" (USB)
CAMERA_BACKEND=mock
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480

# Inference: "mock" (random walk, no model) or "tflite" (needs a model file
# in models/ and a TFLite runtime; falls back to mock if either is missing).
# No trained model is shipped with this repository.
AI_MODE=mock
MODEL_FILE=plant_disease.tflite
CONFIDENCE_THRESHOLD=0.25

# Fusion defaults (editable live via POST /api/settings)
DEFAULT_W1=0.6
DEFAULT_W2=0.4
DEFAULT_THETA=0.5
DEFAULT_CROP=tomato

# Sensor calibration (ADC counts and stress thresholds in %). These are
# starting values, not calibrated against real probes.
MOISTURE_DRY=2800
MOISTURE_WET=1200
MOISTURE_STRESS_THRESHOLD=30.0
WATER_DRY=3000
WATER_WET=500
WATER_STRESS_THRESHOLD=20.0

# Seconds between capture-infer-fuse cycles
CYCLE_INTERVAL_S=30
