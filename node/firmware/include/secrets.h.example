// Copy this file to secrets.h and fill in your values.
// secrets.h is gitignored. Never commit real credentials.
#pragma once

// WiFi network the ESP32 joins
#define WIFI_SSID "YOUR_WIFI_SSID"
#define WIFI_PASS "YOUR_WIFI_PASSWORD"

// Address of the Raspberry Pi node (find it on the Pi with `hostname -I`)
#define RPI_HOST "YOUR_RPI_IP"
#define RPI_PORT 8000

// Must match NODE_ID in node/rpi/.env
#define NODE_ID "FL-001"

// Optional: must match API_KEY in node/rpi/.env. Leave empty if unset.
#define API_KEY ""
